{
  "name": "sg-healthcare-pathway-game",
  "private": true,
  "version": "9.0.0",
  "type": "module",
  "description": "Educational simulation game of patient pathways through Singapore's healthcare network.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "vitest run && tsc -b && vite build",
    "bake:scenes": "vite-node scripts/bake-scenes.mjs",
    "fetch:3d": "node scripts/fetch-3d-assets.mjs",
    "map:cast": "node scripts/map-quaternius-cast.mjs",
    "make:cast": "blender --background --python scripts/make-cast.py",
    "make:cpr": "blender --background --python scripts/make-cpr.py",
    "make:supine": "blender --background --python scripts/make-cpr.py -- --supine",
    "make:kneel": "blender --background --python scripts/make-cpr.py -- --kneel"
  },
  "dependencies": {
    "phaser": "^3.80.1",
    "postprocessing": "6.39.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "0.184.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.0",
    "@gltf-transform/functions": "^4.4.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^25.8.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "0.184.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "playwright": "^1.61.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vite-node": "^6.0.0",
    "vitest": "^2.0.3"
  }
}
